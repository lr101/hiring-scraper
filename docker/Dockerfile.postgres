ARG POSTGIS_IMAGE=postgis/postgis:17-3.5
FROM ${POSTGIS_IMAGE}

# Keep PostgreSQL and PostGIS on the same major version, and build pgvector
# from its pinned upstream release. Keep the Debian/glibc base: the persistent
# database cluster was initialized with its libc collation provider.
ARG PGVECTOR_VERSION=v0.8.7
RUN getconf GNU_LIBC_VERSION 2>/dev/null | grep -q '^glibc ' || { \
        echo 'PostgreSQL image must use glibc for its persistent cluster' >&2; exit 1; \
    } \
    && find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i \
        -e 's#deb.debian.org/debian#archive.debian.org/debian#g' \
        -e 's#security.debian.org/debian-security#archive.debian.org/debian-security#g' \
        -e 's#apt.postgresql.org/pub/repos/apt#apt-archive.postgresql.org/pub/repos/apt#g' \
        -e 's#bullseye-pgdg main#bullseye-pgdg-archive main#g' {} + \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        build-essential clang-11 git llvm-11-dev postgresql-server-dev-17 \
    && git clone --depth 1 --branch "${PGVECTOR_VERSION}" https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && make -C /tmp/pgvector OPTFLAGS="" \
    && make -C /tmp/pgvector install \
    && rm -rf /tmp/pgvector \
    && apt-get purge -y --auto-remove \
        build-essential clang-11 git llvm-11-dev postgresql-server-dev-17 \
    && rm -rf /var/lib/apt/lists/*
