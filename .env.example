# Replace both values with different URL-safe random secrets before deployment.
# Generate a value with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-admin-secret
HIRING_DB_PASSWORD=replace-with-a-different-random-hex-app-secret

# The app is available at http://localhost:8080 by default.
APP_BIND=0.0.0.0
APP_PORT=8080

# Compose pulls the public image from GHCR by default. For a pinned deployment,
# set HIRING_APP_IMAGE to a full commit tag or digest before running `docker compose pull`.
# HIRING_APP_IMAGE=ghcr.io/lr101/hiring-scraper/hiring-scraper:COMMIT_SHA

# User agents identify requests made by the location and job discovery workers.
NOMINATIM_USER_AGENT=HiringScraper/0.2 (location search)
HIRING_USER_AGENT=HiringScraper/0.2 (public job discovery)

# Optional crawl tuning. These match the application defaults.
FEED_SCAN_INTERVAL_HOURS=6
CRAWL_DELAY_SECONDS=1
CAREER_DISCOVERY_INTERVAL_DAYS=30
CAREER_DISCOVERY_POLL_SECONDS=30
CAREER_DISCOVERY_DELAY_SECONDS=1
CAREER_DISCOVERY_WORKERS=4
CAREER_DISCOVERY_MAX_PAGES=6
CAREER_DISCOVERY_MAX_DEPTH=3
CAREER_DISCOVERY_MAX_REQUESTS=24
