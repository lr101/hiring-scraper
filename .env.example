DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_PASSWORD=replace-with-a-database-password
APP_PORT=8000
GUNICORN_WORKERS=2
COMPANY_DISCOVERY_TIMEOUT_SECONDS=15
COMPANY_DISCOVERY_USER_AGENT="hiring-scraper/0.1 (self-hosted company discovery)"
COLLECTION_USER_AGENT="hiring-scraper/0.1 (self-hosted job collection)"
BA_JOBS_API_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service
BA_JOBS_API_KEY=jobboerse-jobsuche
BA_JOBS_TIMEOUT_SECONDS=30
BA_JOBS_RESULT_LIMIT=100
BA_JOBS_MAX_PAGES=5
BA_JOBS_MIN_REQUEST_INTERVAL_SECONDS=2
BA_JOBS_RATE_LIMIT_STATE_PATH=/tmp/hiring-scraper-ba-jobs-rate-limit
BA_JOBS_USER_AGENT="hiring-scraper/0.1 (self-hosted BA job discovery)"
COMMON_CRAWL_INDEX_BASE_URL=https://index.commoncrawl.org
COMMON_CRAWL_SNAPSHOT=
COMMON_CRAWL_TIMEOUT_SECONDS=30
COMMON_CRAWL_VALIDATION_TIMEOUT_SECONDS=30
COMMON_CRAWL_MAX_RECORDS_PER_QUERY=100
COMMON_CRAWL_MAX_PATTERNS=12
COMMON_CRAWL_MIN_REQUEST_INTERVAL_SECONDS=1
COMMON_CRAWL_RATE_LIMIT_STATE_PATH=/tmp/hiring-scraper-common-crawl-rate-limit
COMMON_CRAWL_USER_AGENT="hiring-scraper/0.1 (self-hosted ATS discovery)"
REVERSE_DISCOVERY_ENABLED=true
REVERSE_DISCOVERY_INTERVAL_SECONDS=86400
COMPANY_LOCATION_API_URL=https://overpass-api.de/api/interpreter
COMPANY_LOCATION_LOOKUP_TIMEOUT_SECONDS=45
COMPANY_LOCATION_MAX_RESULTS=25
COMPANY_LOCATION_MIN_REQUEST_INTERVAL_SECONDS=2
COMPANY_LOCATION_RATE_LIMIT_STATE_PATH=/tmp/hiring-scraper-company-location-rate-limit
COMPANY_LOCATION_USER_AGENT="hiring-scraper/0.1 (self-hosted company lookup)"
COMPANY_LOCATION_FALLBACK_API_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
LOCATION_API_URL=https://nominatim.openstreetmap.org/search
LOCATION_LOOKUP_TIMEOUT_SECONDS=10
LOCATION_USER_AGENT="hiring-scraper/0.1 (self-hosted location lookup)"
LOCATION_MIN_REQUEST_INTERVAL_SECONDS=1
LOCATION_RATE_LIMIT_STATE_PATH=/tmp/hiring-scraper-location-rate-limit
